# 이 파일을 .env 로 복사해 값을 채우세요.  (.env 는 gitignore 로 커밋 제외)

# ── Google (기본 provider) ─────────────────────────────────────────────────
# AI Studio 무료 키: https://aistudio.google.com/apikey
# ⚠️ 무료 티어는 프롬프트를 학습에 사용할 수 있음 → 실제 PII 절대 금지, 합성 데이터만.
GOOGLE_API_KEY=

# ── OpenAI (대체/비교 provider, 선택) ──────────────────────────────────────
OPENAI_API_KEY=

# ── HuggingFace (gated Gemma/ShieldGemma·데이터셋 접근) ─────────────────────
HF_TOKEN=

# ── (선택) Vertex AI — 실데이터/데이터 미학습 경로 ─────────────────────────
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
