# 시크릿
.env
.env.*
!.env.example
# 자체학습 레일 가중치 (ko_agentguard·e5) — CC-BY-4.0 데이터 학습 → 재배포 가능하나
#   대용량 바이너리라 git 위생상 제외. 공개 HF(cycloevan/safeagent-kr)에 있음 → scripts.fetch_rail 로 취득.
train/artifacts/*/
train/artifacts/*.joblib
# klue 파생 가중치 (R6 PII·R7 유해성) — CC-BY-SA 상속·라이선스 고려로 공개 HF 배포 지양, 로컬 보관만
models/
# 캐시/런타임
.venv/
__pycache__/
*.pyc
.pytest_cache/
data/cassettes/
# 원시 실행 로그 — tqdm 진행바가 대부분이고, 의미 있는 수치는 results/*.json 에 구조화돼 있다.
#   (train_pii.log 는 RunPod 작업경로도 노출한다)
results/*.log
# 런타임 관측 산출물(재생성됨)
results/.progress.json
results/.progress.json.tmp
# 임시
TEMP.md
*.bak
~$*

# 합성 코퍼스 산출물 — 커밋 금지 (DESIGN.md §5.3.5.1)
# 체크섬 유효 주민등록번호는 실존 번호와 우연히 일치할 수 있다(2세대 7.0e-3).
# 생성기와 seed만 배포하고 값은 평가 시점에 만든다.
data/synth/
data/corpus/
bench/out/
